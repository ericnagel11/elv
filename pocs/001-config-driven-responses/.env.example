# Development only: copy to .env and supply approved existing resource metadata.
# Nonsecret endpoints/IDs only. Do not run legacy provisioners on shared services.
# azure-vm mode ignores dotenv; supply these values in the process environment.
# Restart BOTH the UI and A2A runtime after environment/dependency changes.
AZURE_APPCONFIG_ENDPOINT=https://<your-appconfig>.azconfig.io
AZURE_APPCONFIG_DRAFT_ENDPOINT=https://<your-draft-appconfig>.azconfig.io
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<existing-approved-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net

# Local A2A 1.0 response agent used by the Streamlit comparison tab.
A2A_AGENT_URL=http://127.0.0.1:9999

# Default PoC001 history: PRIVATE, dedicated, owner-precreated container.
# This does not create containers, change permissions, or enable public access.
ELV_AUDIT_BACKEND=blob
ELV_AUDIT_BLOB_ACCOUNT_URL=https://tenxengbenefitaistandard.blob.core.windows.net
ELV_AUDIT_BLOB_CONTAINER=poc001-config-history
# VM identity mapping only (development uses DefaultAzureCredential instead).
# Reader reuses the dedicated audit service identity. Writer must be a separate
# VM-attached UAMI, distinct from this reader and every configured persona UUID.
# Writer: Storage Blob Data Contributor; reader: Storage Blob Data Reader.
# Scope grants to this container only, never the account or a broader root.
ELV_MI_AUDIT_CLIENT_ID=<audit-reader-managed-identity-client-uuid>
ELV_AUDIT_BLOB_WRITER_CLIENT_ID=<separate-history-writer-managed-identity-client-uuid>
# Blob URL/container/writer failures warn, not block startup. Normal VM persona
# and audit-reader UUID validation still applies.
# Never put PHI, secrets, tokens, account keys, SAS or connection strings here.

# Optional legacy mode: replace ELV_AUDIT_BACKEND above with loganalytics.
# Requires existing approved workspace/diagnostics; never an automatic fallback.
# AZURE_LOG_ANALYTICS_WORKSPACE_ID=<workspace-customer-uuid>
# azure-vm legacy LA mode additionally requires both App Configuration ARM IDs:
# AZURE_APPCONFIG_RESOURCE_ID=/subscriptions/<subscription-uuid>/resourceGroups/<group>/providers/Microsoft.AppConfiguration/configurationStores/<your-appconfig>
# AZURE_APPCONFIG_DRAFT_RESOURCE_ID=/subscriptions/<subscription-uuid>/resourceGroups/<group>/providers/Microsoft.AppConfiguration/configurationStores/<your-draft-appconfig>
