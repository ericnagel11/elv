# Copy to .env and fill in your endpoints. Contains NO secrets (endpoints only).
# scripts/setup.ps1 writes this file for you.
AZURE_APPCONFIG_ENDPOINT=https://<your-appconfig>.azconfig.io
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Added by scripts/setup-governance.ps1 for the RBAC demonstration.
AZURE_APPCONFIG_DRAFT_ENDPOINT=https://<your-draft-appconfig>.azconfig.io
AZURE_LOG_ANALYTICS_WORKSPACE_ID=<log-analytics-workspace-guid>

# Added by scripts/setup-knowledge.ps1. One index per language sits behind an
# alias, so the endpoint is shared and the alias name comes from configuration.
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net

# Added by scripts/setup-language.ps1 for the language-adherence guardrail.
# Optional. Without it the guardrail reports as unavailable rather than failing.
AZURE_LANGUAGE_ENDPOINT=https://<your-language-service>.cognitiveservices.azure.com/
