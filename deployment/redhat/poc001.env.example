# systemd EnvironmentFile syntax: literal KEY=value; no export or shell expansion.
# Nonsecret metadata ONLY. Replace every <placeholder> before starting services.
# The launcher enforces azure-vm mode and loopback endpoints independently.
ELV_HOSTING_MODE=azure-vm
AZURE_TENANT_ID=<target-tenant-uuid>
AZURE_APPCONFIG_ENDPOINT=https://<poc001-live-store>.azconfig.io
AZURE_APPCONFIG_DRAFT_ENDPOINT=https://<poc001-draft-store>.azconfig.io
AZURE_APPCONFIG_RESOURCE_ID=/subscriptions/<subscription-uuid>/resourceGroups/<group>/providers/Microsoft.AppConfiguration/configurationStores/<poc001-live-store>
AZURE_APPCONFIG_DRAFT_RESOURCE_ID=/subscriptions/<subscription-uuid>/resourceGroups/<group>/providers/Microsoft.AppConfiguration/configurationStores/<poc001-draft-store>
AZURE_OPENAI_ENDPOINT=https://<existing-openai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<existing-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SEARCH_ENDPOINT=https://<existing-search>.search.windows.net
AZURE_LOG_ANALYTICS_WORKSPACE_ID=<workspace-customer-uuid>
ELV_MI_VIEWER_CLIENT_ID=<viewer-managed-identity-client-uuid>
ELV_MI_DESIGNER_CLIENT_ID=<designer-managed-identity-client-uuid>
ELV_MI_APPROVER_CLIENT_ID=<approver-managed-identity-client-uuid>
ELV_MI_APP_CLIENT_ID=<runtime-managed-identity-client-uuid>
ELV_MI_AUDIT_CLIENT_ID=<audit-managed-identity-client-uuid>
# Preserve proxy bypass for IMDS and loopback; append organization-specific hosts.
NO_PROXY=169.254.169.254,127.0.0.1,localhost
no_proxy=169.254.169.254,127.0.0.1,localhost